# Copie este archivo como .env y complete los valores.

# --- Base de datos ---
DB_ROOT_PASSWORD=cambiar-esta-clave-root
DB_USER=lpt
DB_PASSWORD=cambiar-esta-clave

# --- Aplicación ---
# Puerto donde se publica la app. En producción con Caddy use 127.0.0.1:3000 para
# que solo Caddy (HTTPS) llegue a la app: Docker abre los puertos publicados por
# encima del firewall del servidor (ufw no los bloquea).
APP_PORT=3000
# URL pública con la que se arman los enlaces de los correos
PUBLIC_URL=http://localhost:3000
# Cadena larga y aleatoria (p. ej. `openssl rand -hex 32`). Obligatoria: con el valor
# de ejemplo o una de menos de 32 caracteres la app no arranca en producción.
SESSION_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
# Póngalo en true cuando el sitio se sirva solo por HTTPS
COOKIE_SECURE=false
# Proxies de los que se acepta la IP real del cliente (X-Forwarded-For). Vacío = solo
# los de la red interna, que cubre a Caddy en Docker. 'false' si no hay proxy.
TRUST_PROXY=

# Primer administrador: se crea al arrancar si la tabla usuarios está vacía
ADMIN_NOMBRE=Administrador LPT
ADMIN_EMAIL=lpt@uct.cl
ADMIN_PASSWORD=cambiar-esta-clave-admin

# --- Correo (SMTP) ---
# Si SMTP_HOST queda vacío, los correos no se envían y se muestran en el log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Servicio de Impresión LPT <lpt@uct.cl>"
# Destinatarios internos: reciben un aviso por cada pedido nuevo y cada cambio de estado
MAIL_LPT=rcallejas@uct.cl,lpt@uct.cl
# Adjuntar el PDF del cliente en el aviso de pedido nuevo (false para solo enviar el enlace al panel)
MAIL_ADJUNTAR_PDF=true
# PDFs más grandes que esto no se adjuntan (el correo crece ~35% al codificarlos)
MAIL_ADJUNTAR_MAX_MB=10

# --- Producción con Caddy (perfil "produccion") ---
DOMINIO=impresion.lpt.uct.cl

# --- Préstamo de equipos ---
# Dominios de correo que pueden pedir equipos (estudiantes y académicos)
PRESTAMO_DOMINIOS=uct.cl,alu.uct.cl
# Lugar de retiro que se propone al aceptar una solicitud
PRESTAMO_LUGAR_RETIRO=Laboratorio de Planificación Territorial (LPT)
# Recordatorios de devolución por correo: el día antes, el día del vencimiento y,
# si no se devolvió, al día siguiente con copia al LPT. false para desactivarlos.
PRESTAMO_RECORDATORIOS=true
# Hora desde la que se envían (0-23, hora de Chile)
PRESTAMO_RECORDATORIO_HORA=9
